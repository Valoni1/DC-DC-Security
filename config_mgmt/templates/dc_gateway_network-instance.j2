{%- set autonomous_system = asn %}
{
  "network-instance": [
    {
      "name": "mgmt",
      "type": "ip-vrf",
      "admin-state": "enable",
      "description": "Management network instance",
      "interface": [
        {
          "name": "mgmt0.0"
        }
      ],
      "protocols": {
        "linux": {
          "import-routes": true,
          "export-routes": true,
          "export-neighbors": true
        }
      }
    },
    {
      "name": "default",
      "router-id": "{{device.primary_ip4.address.split('/')[0]}}",
      "interface": [
        {%- for interface_name, interface in interfaces.items() %}
        {
          "name": "{{interface_name}}.0"
        },
        {%- endfor %}
        {
          "name": "lo0.0"
        }
      ],
      "protocols": {
        "bgp": {
          "admin-state": "enable",
          "autonomous-system": {{autonomous_system}},
          "router-id": "{{device.primary_ip4.address.split('/')[0]}}",
          "afi-safi": [
            {
              "afi-safi-name": "evpn",
              "admin-state": "enable"
            },
            {
              "afi-safi-name": "ipv4-unicast",
              "admin-state": "enable"
            }
          ],
          "group": [
            {
              "group-name": "superspine",
              "admin-state": "enable",
              "send-community": {
                "standard": true,
                "large": true
              }
            },
            {
              "group-name": "dci",
              "admin-state": "enable",
              "send-community": {
                "standard": true,
                "large": true
              }
            }
          ],
          "neighbor": [
            {%- for peer_name, peer in peers.items() %}
            {
              "description" : "{{peer_name}}",
              "peer-address": "{{peer.remote_ip.split('/')[0]}}",
              "peer-group": "{{ "dci" if peer.is_dci else "superspine" }}",
              "peer-as": {{peer.asn}},
              "admin-state": "enable"
            }{{ ", " if not loop.last else "" }}
            {%- endfor %}
          ]
        },
        "ospf": {
          "instance": [
            {
              "name": "0",
              "admin-state": "enable",
              "version": "ospf-v2",
              "area": [
                {
                  "area-id": "0.0.0.0",
                  "interface": [
                    {#- The IGP stays inside each DC; only eBGP crosses the DCI link #}
                    {%- for interface_name, interface in interfaces.items() if not interface.is_dci %}
                    {
                      "interface-name": "{{interface_name}}.0",
                      "interface-type": "point-to-point"
                    },
                    {%- endfor %}
                    {
                      "interface-name": "lo0.0",
                      "passive": true
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ]
}