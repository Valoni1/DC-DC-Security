# ScopeWeaver for the DC1/DC2 lab.
# setup_scopeweaver.sh copies this to src/.env on first run; edit that copy
# (it is git-ignored) to paste your key. Keep real keys out of this file.
SCOPEWEAVER_LANGUAGE=en

# PostgreSQL (internal to the stack; no port is published)
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM: DeepSeek via its OpenAI-compatible API. ScopeWeaver talks to any
# "OpenAI Chat Completions" endpoint, so we set the OpenAI provider, point the
# base URL at DeepSeek, and give the DeepSeek key as OPENAI_API_KEY.
# Paste your DeepSeek key below. deepseek-chat is the default; use
# deepseek-reasoner for the stronger (slower) reasoning model.
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=openai
ARTEX_LLM_BASE_URL=https://api.deepseek.com
ARTEX_LLM_MODEL=deepseek-chat

# Leave hosted. Only set this true (with a local Ollama) to avoid the API call.
SCOPEWEAVER_LOCAL_LLM_ONLY=false
