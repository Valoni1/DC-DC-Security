# ScopeWeaver for the DC1/DC2 lab.
# setup_scopeweaver.sh copies this to src/.env on first run; edit that copy
# (it is git-ignored) to paste your key. Keep real keys out of this file.
SCOPEWEAVER_LANGUAGE=en

# PostgreSQL (internal to the stack; no port is published)
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM: hosted Claude via the Anthropic API (recommended for this agent).
# Paste your key below. Sonnet is the default; swap to claude-opus-5-5 for
# maximum reasoning at higher cost/latency.
ANTHROPIC_API_KEY=
ARTEX_LLM_PROVIDER=anthropic
ARTEX_LLM_MODEL=claude-sonnet-5-5

# Leave hosted. Only set this true (with a local Ollama) to avoid the API call.
SCOPEWEAVER_LOCAL_LLM_ONLY=false
