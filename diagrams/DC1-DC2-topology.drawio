<mxfile host="app.diagrams.net"><diagram id="dc1dc2" name="DC1-DC2 network"><mxGraphModel dx="2900" dy="1600" grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;DC1&lt;/b&gt; &amp;nbsp;(NetBox site DC1, containerlab group DC1)&lt;br&gt;loopbacks 172.20.1.0/24 &amp;nbsp;·&amp;nbsp; fabric links /31s from 10.1.1.0/24 &amp;nbsp;·&amp;nbsp; host LANs /28s from 172.30.1.0/24 &amp;nbsp;·&amp;nbsp; OSPFv2 area 0.0.0.0 inside the DC" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="1280" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;DC2&lt;/b&gt; &amp;nbsp;(NetBox site DC2, containerlab group DC2)&lt;br&gt;loopbacks 172.20.2.0/24 &amp;nbsp;·&amp;nbsp; fabric links /31s from 10.1.2.0/24 &amp;nbsp;·&amp;nbsp; host LANs /28s from 172.30.2.0/24 &amp;nbsp;·&amp;nbsp; OSPFv2 area 0.0.0.0 inside the DC" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1500" y="0" width="1400" height="1280" as="geometry"/></mxCell><mxCell id="dc1-dci-r1" value="&lt;b&gt;dc1-dci-r1&lt;/b&gt;&lt;br&gt;DC Gateway · AS 65201&lt;br&gt;lo0 172.20.1.1/32" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="620.0" y="110" width="160" height="66" as="geometry"/></mxCell><mxCell id="dc1-ss1" value="&lt;b&gt;dc1-ss1&lt;/b&gt;&lt;br&gt;Superspine · AS 65101&lt;br&gt;lo0 172.20.1.21/32" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620.0" y="270" width="160" height="66" as="geometry"/></mxCell><mxCell id="dc1-sp1" value="&lt;b&gt;dc1-sp1&lt;/b&gt;&lt;br&gt;Spine · AS 65001&lt;br&gt;lo0 172.20.1.11/32" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="620.0" y="440" width="160" height="66" as="geometry"/></mxCell><mxCell id="dc1-l1" value="&lt;b&gt;dc1-l1&lt;/b&gt;&lt;br&gt;Leaf · AS 65001&lt;br&gt;lo0 172.20.1.101/32" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620.0" y="640" width="160" height="66" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="dc1-sp1" target="dc1-l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="dc1-sp1" target="dc1-ss1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="dc1-ss1" target="dc1-dci-r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dc1-h1" value="&lt;b&gt;dc1-h1&lt;/b&gt; (Linux)&lt;br&gt;172.30.1.2/28" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="585.0" y="760" width="110" height="50" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=1;" edge="1" parent="1" source="dc1-h1" target="dc1-l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dc1-w1" value="&lt;b&gt;dc1-w1&lt;/b&gt; (Windows)&lt;br&gt;172.30.1.98/28" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="705.0" y="760" width="110" height="50" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=1;" edge="1" parent="1" source="dc1-w1" target="dc1-l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;DC1 links (5: 3 fabric, 2 host)&lt;/b&gt; &amp;nbsp;— from ip_plan_dc1_dc2.yaml; containerlab name e1-N = ethernet-1/N&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;font-family:monospace;width:100%&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;A end&lt;/th&gt;&lt;th&gt;interface&lt;/th&gt;&lt;th&gt;IPv4&lt;/th&gt;&lt;th&gt;B end&lt;/th&gt;&lt;th&gt;interface&lt;/th&gt;&lt;th&gt;IPv4&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;dc1-sp1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;10.1.1.0/31&lt;/td&gt;&lt;td&gt;dc1-l1&lt;/td&gt;&lt;td&gt;ethernet-1/28&lt;/td&gt;&lt;td&gt;10.1.1.1/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;dc1-sp1&lt;/td&gt;&lt;td&gt;ethernet-1/7&lt;/td&gt;&lt;td&gt;10.1.1.24/31&lt;/td&gt;&lt;td&gt;dc1-ss1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;10.1.1.25/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;dc1-ss1&lt;/td&gt;&lt;td&gt;ethernet-1/3&lt;/td&gt;&lt;td&gt;10.1.1.32/31&lt;/td&gt;&lt;td&gt;dc1-dci-r1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;10.1.1.33/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;dc1-l1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;172.30.1.1/28&lt;/td&gt;&lt;td&gt;dc1-h1&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.1.2/28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;dc1-l1&lt;/td&gt;&lt;td&gt;ethernet-1/2&lt;/td&gt;&lt;td&gt;172.30.1.97/28&lt;/td&gt;&lt;td&gt;dc1-w1&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.1.98/28&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="1360" height="400" as="geometry"/></mxCell><mxCell id="dc2-dci-r1" value="&lt;b&gt;dc2-dci-r1&lt;/b&gt;&lt;br&gt;DC Gateway · AS 65202&lt;br&gt;lo0 172.20.2.1/32" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2120.0" y="110" width="160" height="66" as="geometry"/></mxCell><mxCell id="dc2-ss1" value="&lt;b&gt;dc2-ss1&lt;/b&gt;&lt;br&gt;Superspine · AS 65102&lt;br&gt;lo0 172.20.2.21/32" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2120.0" y="270" width="160" height="66" as="geometry"/></mxCell><mxCell id="dc2-sp1" value="&lt;b&gt;dc2-sp1&lt;/b&gt;&lt;br&gt;Spine · AS 65002&lt;br&gt;lo0 172.20.2.11/32" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2120.0" y="440" width="160" height="66" as="geometry"/></mxCell><mxCell id="dc2-l1" value="&lt;b&gt;dc2-l1&lt;/b&gt;&lt;br&gt;Leaf · AS 65002&lt;br&gt;lo0 172.20.2.101/32" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2120.0" y="640" width="160" height="66" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="dc2-sp1" target="dc2-l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="dc2-sp1" target="dc2-ss1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=none;html=1;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="dc2-ss1" target="dc2-dci-r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dc2-h1" value="&lt;b&gt;dc2-h1&lt;/b&gt; (Linux)&lt;br&gt;172.30.2.2/28" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2085.0" y="760" width="110" height="50" as="geometry"/></mxCell><mxCell id="e12" value="" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=1;" edge="1" parent="1" source="dc2-h1" target="dc2-l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dc2-w1" value="&lt;b&gt;dc2-w1&lt;/b&gt; (Windows)&lt;br&gt;172.30.2.98/28" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2205.0" y="760" width="110" height="50" as="geometry"/></mxCell><mxCell id="e13" value="" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=1;" edge="1" parent="1" source="dc2-w1" target="dc2-l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;DC2 links (5: 3 fabric, 2 host)&lt;/b&gt; &amp;nbsp;— from ip_plan_dc1_dc2.yaml; containerlab name e1-N = ethernet-1/N&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;font-family:monospace;width:100%&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;A end&lt;/th&gt;&lt;th&gt;interface&lt;/th&gt;&lt;th&gt;IPv4&lt;/th&gt;&lt;th&gt;B end&lt;/th&gt;&lt;th&gt;interface&lt;/th&gt;&lt;th&gt;IPv4&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;dc2-sp1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;10.1.2.0/31&lt;/td&gt;&lt;td&gt;dc2-l1&lt;/td&gt;&lt;td&gt;ethernet-1/28&lt;/td&gt;&lt;td&gt;10.1.2.1/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;dc2-sp1&lt;/td&gt;&lt;td&gt;ethernet-1/7&lt;/td&gt;&lt;td&gt;10.1.2.24/31&lt;/td&gt;&lt;td&gt;dc2-ss1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;10.1.2.25/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;dc2-ss1&lt;/td&gt;&lt;td&gt;ethernet-1/3&lt;/td&gt;&lt;td&gt;10.1.2.32/31&lt;/td&gt;&lt;td&gt;dc2-dci-r1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;10.1.2.33/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;dc2-l1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;172.30.2.1/28&lt;/td&gt;&lt;td&gt;dc2-h1&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.2.2/28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;dc2-l1&lt;/td&gt;&lt;td&gt;ethernet-1/2&lt;/td&gt;&lt;td&gt;172.30.2.97/28&lt;/td&gt;&lt;td&gt;dc2-w1&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.2.98/28&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="860" width="1360" height="400" as="geometry"/></mxCell><mxCell id="e15" value="DCI primary · eBGP AS 65201 ↔ AS 65202 · BFD" style="endArrow=none;html=1;strokeColor=#1f5fbf;strokeWidth=4;fontSize=12;fontStyle=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="dc1-dci-r1" target="dc2-dci-r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l16" value="dc1-dci-r1 ethernet-1/3&lt;br&gt;10.1.0.0/31" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e15"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="l17" value="dc2-dci-r1 ethernet-1/3&lt;br&gt;10.1.0.1/31" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e15"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="e18" value="DCI backup · eBGP AS 65201 ↔ AS 65202 · BFD" style="endArrow=none;html=1;strokeColor=#1f5fbf;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;exitX=1;exitY=0.65;entryX=0;entryY=0.65;" edge="1" parent="1" source="dc1-dci-r1" target="dc2-dci-r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l19" value="dc1-dci-r1 ethernet-1/4&lt;br&gt;10.1.0.2/31" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e18"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="l20" value="dc2-dci-r1 ethernet-1/4&lt;br&gt;10.1.0.3/31" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e18"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="l21" value="no OSPF on the DCI links" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e18"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="v22" value="&lt;b&gt;Routing (as rendered by config_mgmt/configure.py templates)&lt;/b&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;OSPFv2&lt;/b&gt;, area 0.0.0.0, point-to-point on every fabric link, lo0 passive. Separate per DC: the DCI interface is left out.&lt;/li&gt;&lt;li&gt;&lt;b&gt;iBGP&lt;/b&gt; leaf ↔ spine inside AS 6500N, peering between lo0 addresses; spines are route reflectors (cluster-id 1). AFI/SAFI: evpn, ipv4-unicast.&lt;/li&gt;&lt;li&gt;&lt;b&gt;eBGP&lt;/b&gt; spine (6500N) ↔ superspine (6510N) and superspine (6510N) ↔ DC gateway (6520N), on the link /31s.&lt;/li&gt;&lt;li&gt;&lt;b&gt;eBGP over DCI&lt;/b&gt; dc1-dci-r1 (65201) ↔ dc2-dci-r1 (65202). Export policy dci-export sends only the local 172.20.N.0/24 loopbacks and 172.30.N.0/24 host LANs (mask 24..32); dci-import accepts all; on the primary DCI link (ethernet-1/3) dci-import-primary also sets local-preference 200, so the backup link (ethernet-1/4) carries traffic only when the primary fails. BFD (1 s x 3, the vSRL minimum) with fast-failover on both DCI sessions. bgp-to-ospf redistributes them into the DC&#x27;s OSPF (gateway is ASBR).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Host LANs&lt;/b&gt;: each leaf is the gateway of its hosts&#x27; /28s, advertised into OSPF as passive interfaces. Hosts route 172.20/16, 172.30/16 and 10.1/16 via the leaf (configure_hosts_dc1_dc2.py); their default route stays on management. Windows hosts are a VM behind NAT in their container, which holds the planned address.&lt;/li&gt;&lt;/ul&gt;The two-DCI version with BFD ran on the lab from 20 October 2026 with 22 routers (failover measured 26 October). In November 2026 the lab was cut to one router per tier (8 in all) and one Linux and one Windows host per DC to free host memory; the remaining addresses are unchanged. Rendered configs in config_mgmt/configs/ are not committed." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="1320" width="1400" height="280" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;Out-of-band management and tooling&lt;/b&gt;&lt;ul&gt;&lt;li&gt;No mgmt block in DC1-DC2.clab.yaml, so containerlab&#x27;s default management network applies (bridge &lt;i&gt;clab&lt;/i&gt;, 172.20.20.0/24). Every node&#x27;s mgmt0 sits in SR Linux network-instance &lt;i&gt;mgmt&lt;/i&gt;; container names are clab-DC1-DC2-&amp;lt;node&amp;gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;graphite&lt;/b&gt; (linux, netreplica/graphite) on the same network, host port 8080 → 80, topology viewer.&lt;/li&gt;&lt;li&gt;&lt;b&gt;NetBox&lt;/b&gt; (docker compose, host port 8000 → 8080) is the source of truth. nrx exports sites DC1, DC2 to containerlab; configure.py pushes configs over JSON-RPC to http://clab-DC1-DC2-&amp;lt;node&amp;gt;/jsonrpc.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Lab host ser10&lt;/b&gt;: containers run under the Docker snap package (29.8.0). The apt docker-ce daemon that held the 6-12 October lab is stopped and masked (tools/host/). With 8 routers the Windows hosts fit in memory and are deployed with the rest of the lab.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="1500" y="1320" width="1400" height="280" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="1630" width="2900" height="110" as="geometry"/></mxCell><mxCell id="v25" value="DC Gateway (AS 6520N)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="1670" width="170" height="40" as="geometry"/></mxCell><mxCell id="v26" value="Superspine (AS 6510N)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="205" y="1670" width="170" height="40" as="geometry"/></mxCell><mxCell id="v27" value="Spine (AS 6500N)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="390" y="1670" width="170" height="40" as="geometry"/></mxCell><mxCell id="v28" value="Leaf (AS 6500N)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="575" y="1670" width="170" height="40" as="geometry"/></mxCell><mxCell id="v29" value="Linux host" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="1670" width="170" height="40" as="geometry"/></mxCell><mxCell id="v30" value="Windows host" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="945" y="1670" width="170" height="40" as="geometry"/></mxCell><mxCell id="v31" value="All 8 routers: Nokia SR Linux (kind srl, type ixrd3l, image ghcr.io/nokia/srlinux:26.7.2), 7220 IXR-D3L. Memory: Spine 2Gb, Leaf 2Gb, Superspine 2Gb, DC Gateway 2Gb.&lt;br&gt;Grey line = intra-DC fabric link (6); thick blue = DCI link; thin blue = host link (4). N = DC number. Hosts: Linux netreplica/ubuntu-host, Windows Server 2022 in dockurr/windows." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="1660" width="1730" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
