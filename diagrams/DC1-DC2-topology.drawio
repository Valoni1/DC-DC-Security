1.2.28/31&lt;/td&gt;&lt;td&gt;dc2-ss1&lt;/td&gt;&lt;td&gt;ethernet-1/2&lt;/td&gt;&lt;td&gt;10.1.2.29/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;16&lt;/td&gt;&lt;td&gt;dc2-sp2&lt;/td&gt;&lt;td&gt;ethernet-1/8&lt;/td&gt;&lt;td&gt;10.1.2.30/31&lt;/td&gt;&lt;td&gt;dc2-ss2&lt;/td&gt;&lt;td&gt;ethernet-1/2&lt;/td&gt;&lt;td&gt;10.1.2.31/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;17&lt;/td&gt;&lt;td&gt;dc2-ss1&lt;/td&gt;&lt;td&gt;ethernet-1/3&lt;/td&gt;&lt;td&gt;10.1.2.32/31&lt;/td&gt;&lt;td&gt;dc2-dci-r1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;10.1.2.33/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;18&lt;/td&gt;&lt;td&gt;dc2-ss2&lt;/td&gt;&lt;td&gt;ethernet-1/3&lt;/td&gt;&lt;td&gt;10.1.2.34/31&lt;/td&gt;&lt;td&gt;dc2-dci-r1&lt;/td&gt;&lt;td&gt;ethernet-1/2&lt;/td&gt;&lt;td&gt;10.1.2.35/31&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;19&lt;/td&gt;&lt;td&gt;dc2-l1&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;172.30.2.1/28&lt;/td&gt;&lt;td&gt;dc2-h1&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.2.2/28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;dc2-l2&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;172.30.2.17/28&lt;/td&gt;&lt;td&gt;dc2-h2&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.2.18/28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;21&lt;/td&gt;&lt;td&gt;dc2-l3&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;172.30.2.33/28&lt;/td&gt;&lt;td&gt;dc2-h3&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.2.34/28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;22&lt;/td&gt;&lt;td&gt;dc2-l4&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;172.30.2.49/28&lt;/td&gt;&lt;td&gt;dc2-h4&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.2.50/28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;23&lt;/td&gt;&lt;td&gt;dc2-l5&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;172.30.2.65/28&lt;/td&gt;&lt;td&gt;dc2-h5&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.2.66/28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;24&lt;/td&gt;&lt;td&gt;dc2-l6&lt;/td&gt;&lt;td&gt;ethernet-1/1&lt;/td&gt;&lt;td&gt;172.30.2.81/28&lt;/td&gt;&lt;td&gt;dc2-h6&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.2.82/28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;25&lt;/td&gt;&lt;td&gt;dc2-l1&lt;/td&gt;&lt;td&gt;ethernet-1/2&lt;/td&gt;&lt;td&gt;172.30.2.97/28&lt;/td&gt;&lt;td&gt;dc2-w1&lt;/td&gt;&lt;td&gt;eth1&lt;/td&gt;&lt;td&gt;172.30.2.98/28&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="860" width="1360" height="560" as="geometry"/></mxCell><mxCell id="e55" value="DCI primary · eBGP AS 65201 ↔ AS 65202 · BFD" style="endArrow=none;html=1;strokeColor=#1f5fbf;strokeWidth=4;fontSize=12;fontStyle=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="dc1-dci-r1" target="dc2-dci-r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l56" value="dc1-dci-r1 ethernet-1/3&lt;br&gt;10.1.0.0/31" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e55"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="l57" value="dc2-dci-r1 ethernet-1/3&lt;br&gt;10.1.0.1/31" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e55"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="e58" value="DCI backup · eBGP AS 65201 ↔ AS 65202 · BFD" style="endArrow=none;html=1;strokeColor=#1f5fbf;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;exitX=1;exitY=0.65;entryX=0;entryY=0.65;" edge="1" parent="1" source="dc1-dci-r1" target="dc2-dci-r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l59" value="dc1-dci-r1 ethernet-1/4&lt;br&gt;10.1.0.2/31" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e58"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="l60" value="dc2-dci-r1 ethernet-1/4&lt;br&gt;10.1.0.3/31" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e58"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="l61" value="no OSPF on the DCI links" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" connectable="0" parent="e58"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="22" as="offset"/></mxGeometry></mxCell><mxCell id="v62" value="&lt;b&gt;Routing (as rendered by config_mgmt/configure.py templates)&lt;/b&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;OSPFv2&lt;/b&gt;, area 0.0.0.0, point-to-point on every fabric link, lo0 passive. Separate per DC: the DCI interface is left out.&lt;/li&gt;&lt;li&gt;&lt;b&gt;iBGP&lt;/b&gt; leaf ↔ spine inside AS 6500N, peering between lo0 addresses; spines are route reflectors (cluster-id 1). AFI/SAFI: evpn, ipv4-unicast.&lt;/li&gt;&lt;li&gt;&lt;b&gt;eBGP&lt;/b&gt; spine (6500N) ↔ superspine (6510N) and superspine (6510N) ↔ DC gateway (6520N), on the link /31s.&lt;/li&gt;&lt;li&gt;&lt;b&gt;eBGP over DCI&lt;/b&gt; dc1-dci-r1 (65201) ↔ dc2-dci-r1 (65202). Export policy dci-export sends only the local 172.20.N.0/24 loopbacks and 172.30.N.0/24 host LANs (mask 24..32); dci-import accepts all; on the primary DCI link (ethernet-1/3) dci-import-primary also sets local-preference 200, so the backup link (ethernet-1/4) carries traffic only when the primary fails. BFD (1 s x 3, the vSRL minimum) with fast-failover on both DCI sessions. bgp-to-ospf redistributes them into the DC&#x27;s OSPF (gateway is ASBR).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Host LANs&lt;/b&gt;: each leaf is the gateway of its hosts&#x27; /28s, advertised into OSPF as passive interfaces. Hosts route 172.20/16, 172.30/16 and 10.1/16 via the leaf (configure_hosts_dc1_dc2.py); their default route stays on management. Windows hosts are a VM behind NAT in their container, which holds the planned address.&lt;/li&gt;&lt;/ul&gt;The single-DCI version was applied with 5_run_config_mgmt.sh and checked on the lab on 19 October 2026 (all 22 routers configured, dc1-h1 reaches dc2-h1). The backup DCI link and BFD shown here are not yet tested. Rendered configs in config_mgmt/configs/ are not committed." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="1480" width="1400" height="280" as="geometry"/></mxCell><mxCell id="v63" value="&lt;b&gt;Out-of-band management and tooling&lt;/b&gt;&lt;ul&gt;&lt;li&gt;No mgmt block in DC1-DC2.clab.yaml, so containerlab&#x27;s default management network applies (bridge &lt;i&gt;clab&lt;/i&gt;, 172.20.20.0/24). Every node&#x27;s mgmt0 sits in SR Linux network-instance &lt;i&gt;mgmt&lt;/i&gt;; container names are clab-DC1-DC2-&amp;lt;node&amp;gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;graphite&lt;/b&gt; (linux, netreplica/graphite) on the same network, host port 8080 → 80, topology viewer.&lt;/li&gt;&lt;li&gt;&lt;b&gt;NetBox&lt;/b&gt; (docker compose, host port 8000 → 8080) is the source of truth. nrx exports sites DC1, DC2 to containerlab; configure.py pushes configs over JSON-RPC to http://clab-DC1-DC2-&amp;lt;node&amp;gt;/jsonrpc.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Lab host ser10&lt;/b&gt;: containers run under the Docker snap package (29.8.0). The apt docker-ce daemon that held the 6-12 October lab is stopped and masked (tools/host/). The Windows hosts are left out of routine deployments because of host memory.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="1500" y="1480" width="1400" height="280" as="geometry"/></mxCell><mxCell id="v64" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="0" y="1790" width="2900" height="110" as="geometry"/></mxCell><mxCell id="v65" value="DC Gateway (AS 6520N)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="1830" width="170" height="40" as="geometry"/></mxCell><mxCell id="v66" value="Superspine (AS 6510N)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="205" y="1830" width="170" height="40" as="geometry"/></mxCell><mxCell id="v67" value="Spine (AS 6500N)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="390" y="1830" width="170" height="40" as="geometry"/></mxCell><mxCell id="v68" value="Leaf (AS 6500N)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="575" y="1830" width="170" height="40" as="geometry"/></mxCell><mxCell id="v69" value="Linux host" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="1830" width="170" height="40" as="geometry"/></mxCell><mxCell id="v70" value="Windows host" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="945" y="1830" width="170" height="40" as="geometry"/></mxCell><mxCell id="v71" value="DVWA host" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1130" y="1830" width="170" height="40" as="geometry"/></mxCell><mxCell id="v72" value="All 22 routers: Nokia SR Linux (kind srl, type ixrd3l, image ghcr.io/nokia/srlinux:26.7.2), 7220 IXR-D3L. Memory: Spine 2Gb, Leaf 2Gb, Superspine 2Gb, DC Gateway 2Gb.&lt;br&gt;Grey line = intra-DC fabric link (37); thick blue = DCI link (1); thin blue = host link (14). N = DC number. Hosts: Linux netreplica/ubuntu-host, Windows Server 2022 in dockurr/windows; dcN-h6 also runs DVWA with MariaDB, replicated DC1 to DC2 over the DCI." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="1820" width="1545" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
