# Python virtual environment (recreate with ./1_create_venv.sh)
venv/
.venv/
__pycache__/
*.pyc

# Containerlab runtime output: generated by `containerlab deploy`,
# includes per-node TLS private keys, SSH authorized_keys and device state
clab-*/

# Private keys and certificates
*.key
*.key.pem

# Database dumps and backups (netbox/netbox_seed.sql is the upstream lab seed
# that docker-compose loads, so it stays tracked)
*.sql
!netbox/netbox_seed.sql
*.bak

# Local secrets
.env
*.local.env

# Rendered by config_mgmt/configure.py on every run
config_mgmt/configs/
*.log

# Windows host disks (dockurr/windows /storage binds, tens of GB each). The
# per-host folders stay tracked: containerlab refuses to deploy if a bind
# source is missing.
windows/*/*
!windows/*/.gitkeep
windows/*.iso
srl_diag.txt
host_check.txt
mgmt_fix.txt
ghost_cleanup.txt
srl_mgmt_fix.txt
