# Python virtual environment (recreate with ./1_create_venv.sh)
venv/
.venv/
__pycache__/
*.pyc

# Containerlab runtime output: generated by `containerlab deploy`,
# includes per-node TLS private keys, SSH authorized_keys and device state
clab-*/

# Private keys and certificates
*.key
*.key.pem

# Database dumps and backups (netbox/netbox_seed.sql is the upstream lab seed
# that docker-compose loads, so it stays tracked)
*.sql
!netbox/netbox_seed.sql
*.bak

# Local secrets
.env
*.local.env
